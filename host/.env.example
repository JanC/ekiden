# Auth method for minting the runner registration token: "token" (default) or "app".
GITHUB_AUTH_METHOD=token

# --- token: personal/org API token (GITHUB_AUTH_METHOD=token) ---
GITHUB_API_TOKEN=<TOKEN>
GITHUB_REGISTRATION_ENDPOINT=https://api.github.com/orgs/<ORG>/actions/runners/registration-token
GITHUB_REGISTRATION_ENDPOINT=https://api.github.com/repos/<ORG>/<REPO>/actions/runners/registration-token

# --- app: GitHub App auth (GITHUB_AUTH_METHOD=app) ---
# Set GITHUB_REPO for a repo-level runner (App needs Administration: Read and write),
# or leave it empty for an org-level runner (App needs Organization self-hosted runners: Read and write).
GITHUB_APP_ID=<APP_ID>
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/app-private-key.pem
GITHUB_OWNER=<ORG>
GITHUB_REPO=<REPO>

VM_USERNAME=admin
VM_PASSWORD=admin

RUNNER_LABELS=self-hosted,arm64
RUNNER_URL=https://github.com/<ORG>
RUNNER_URL=https://github.com/<ORG>/<REPO>
RUNNER_NAME=runner

REGISTRY_URL=<REGISTRY_URL>
REGISTRY_IMAGE_NAME=runner:latest

TRUNCATE_SIZE=200g

VM_RAM=8192
